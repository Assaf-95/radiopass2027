# RadioPass — Apache/LiteSpeed configuration for plain drop-in hosting.
#
# This file ships inside the app so that copying the deploy folder into
# public_html is the whole deployment. It does two jobs:
#
#   1. Deep links. The site is a single-page app: /mri/slice-selection is not
#      a file on disk, so without a rewrite a refresh there is a 404. Anything
#      that is not a real file falls back to the app shell, which routes it.
#   2. Caching. Built assets carry a content hash in their filename, so they
#      can be cached forever; the shell must always be revalidated or a
#      browser keeps loading chunk names that no longer exist after a deploy.
#
# The anatomy app lives under /anatomy/ as its own bundle. It routes with
# Since the merge there is ONE application. /anatomy is one of its routes, and
# public/anatomy/ holds only media, so anatomy deep links need exactly the same
# fallback every other route needs.

Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Anything that is not a real FILE is a client route.
  #
  # Two rules used to sit here and both are now wrong. The first excluded
  # /anatomy entirely, because anatomy was a separate app with its own
  # index.html; left in place after the merge it would have 404'd every
  # anatomy deep link on the live host — /anatomy/atlas is a route now, not a
  # file. The second tested !-d, and public/anatomy IS a real directory, so a
  # request for /anatomy would have been served as a directory rather than
  # handed to the app.
  #
  # Testing files alone is correct for a single-page app: the real assets
  # (assets/, visuals/*.html, anatomy/images/*) are files and are served
  # before this rule is reached; everything else belongs to the router.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # The app shell: always revalidate.
  <FilesMatch "^(index\.html|404\.html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Hashed bundles only (name-XXXXXXXX.js/.css): immutable. Un-hashed files
  # (favicons, hero posters) deliberately keep the host's default caching so
  # a redeploy can actually replace them.
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
