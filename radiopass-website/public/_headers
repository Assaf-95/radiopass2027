# RadioPass — caching rules for Netlify.
#
# The companion to public/.htaccess, which does the same two jobs on Apache
# hosts and which Netlify ignores entirely. Deep links are handled separately
# by public/_redirects; this file is only about caching.
#
# Keep the two in step: if the caching intent changes in one, change it in the
# other, or the same build behaves differently depending on where it landed.

# Built bundles carry a content hash in the filename, so a changed file is a
# changed name. They can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The shell must always be revalidated. Cache it and a returning browser keeps
# asking for chunk names that no longer exist after a deploy, which presents
# as a blank page that a hard refresh mysteriously fixes.
/index.html
  Cache-Control: no-cache, must-revalidate
/404.html
  Cache-Control: no-cache, must-revalidate
