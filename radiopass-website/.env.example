# Copy this file to .env and fill in your Supabase project's values —
# Project Settings → API in the Supabase dashboard.
#
# VITE_SUPABASE_ANON_KEY is the public "anon" key: it is meant to be
# embedded in client-side code. It is not a secret — the schema's Row
# Level Security policies are what actually protect user data.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the anatomy app lives. Leave unset: it defaults to "/anatomy", the
# subfolder both apps ship into on one host. Only set this if you ever split
# them back onto separate deployments, e.g.
# VITE_ANATOMY_URL=https://anatomy.example.com
