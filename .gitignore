# RadioPass — one repository, both branches.
#
#   radiopass-website/            the Physics app (Vite, BrowserRouter, served at /)
#   ANATOMY CLAUDE/frcr-anatomy/  the Anatomy app (Vite, HashRouter, served at /anatomy/)
#
# Everything that is source, content, or an irreplaceable asset is tracked. What is
# excluded below is either regenerable, secret, or superseded.

# --- dependencies and build output (regenerable) ---
node_modules/
dist/
dist-ssr/
deploy/
.netlify/

# --- secrets and local overrides ---
# .env carries the Supabase project URL and anon key. The anon key is meant to be
# public, but the file is local configuration and stays out of history.
# .env.example IS tracked, so a fresh clone knows what to fill in.
.env
.env.local
*.local
.content-dev

# --- OS and editor noise ---
.DS_Store
*.log
.vscode/*
!.vscode/extensions.json
.idea

# --- QA capture artefacts ---
# The qa/*.mjs scripts and the audit notes are tracked; the 77 MB of PNGs they
# emit are not — they are re-shot from the scripts on demand.
# Leading **/ is required: a pattern containing an internal slash is anchored to
# this file's directory, so a bare "qa/screenshots/" would miss both apps' copies.
**/qa/screenshots/

# --- superseded work ---
# 6.8 GB of earlier iterations, five of which contain their own nested .git
# directories. Kept on disk deliberately, kept out of this repository entirely.
archive-historical/

# A staging area the author uses before deleting things. Not source.
ANATOMY CLAUDE/POTENTIAL DELETE/

# Deployment bundle — rebuilt by `npm run package`, never committed (38 MB).
radiopass-website/radiopass-godaddy.zip
radiopass-website/deploy/

# Sanity Studio
studio/node_modules
studio/dist
studio/.sanity
studio/.env

# Supabase local
supabase/.temp
supabase/.branches
.env.local
.wrangler/
